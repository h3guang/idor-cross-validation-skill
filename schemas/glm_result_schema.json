{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "GLM扫描结果",
  "type": "object",
  "required": ["platform", "scan_time", "target", "vulnerabilities", "summary"],
  "properties": {
    "platform": {
      "type": "string",
      "enum": ["GLM"]
    },
    "scan_time": {
      "type": "string",
      "format": "date-time"
    },
    "target": {
      "type": "string",
      "format": "uri"
    },
    "scanned_apis": {
      "type": "integer",
      "minimum": 0
    },
    "test_accounts": {
      "type": "object",
      "properties": {
        "admin": {"type": "string"},
        "user1": {"type": "string"},
        "user2": {"type": "string"}
      }
    },
    "vulnerabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "endpoint", "severity", "confidence"],
        "properties": {
          "id": {"type": "string"},
          "type": {"type": "string"},
          "category": {"type": "string"},
          "endpoint": {"type": "string"},
          "method": {"type": "string"},
          "business_analysis": {"type": "string"},
          "test_method": {"type": "string"},
          "request": {"type": "string"},
          "response_status": {"type": "integer"},
          "response_data": {"type": "string"},
          "severity": {
            "type": "string",
            "enum": ["Critical", "High", "Medium", "Low"]
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "evidence": {"type": "object"},
          "fix_suggestion": {"type": "string"}
        }
      }
    },
    "summary": {
      "type": "object",
      "properties": {
        "critical": {"type": "integer"},
        "high": {"type": "integer"},
        "medium": {"type": "integer"},
        "low": {"type": "integer"},
        "total": {"type": "integer"}
      }
    }
  }
}
